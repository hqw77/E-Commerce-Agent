
# ==========================================
# Application
# ==========================================
APP_NAME=E-Commerce Agent
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=console

# ==========================================
# MySQL
# ==========================================
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=ecommerce_agent

# ==========================================
# Redis
# ==========================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ==========================================
# DeepSeek
# ==========================================
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat


# Generate a random secret with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ISSUER=ecommerce-agent
JWT_AUDIENCE=ecommerce-agent-api
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_LEEWAY_SECONDS=30

# ==========================================
# Orders / payments / after-sales
# ==========================================
ORDER_PAYMENT_TIMEOUT_MINUTES=30
AFTER_SALES_WINDOW_HOURS=168

# ==========================================
# Alipay sandbox (leave empty to disable)
# ==========================================
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi.alipaydev.com/gateway.do
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=
ALIPAY_FRONTEND_RETURN_URL=
