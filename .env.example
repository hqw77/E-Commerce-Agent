
# ==========================================
# Application
# ==========================================
APP_NAME=E-Commerce Agent
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=console

# ==========================================
# MySQL
# ==========================================
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=ecommerce_agent

# ==========================================
# Redis
# ==========================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ==========================================
# DeepSeek
# ==========================================
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Agent LLM (TASK-006.1)
AGENT_LLM_TIMEOUT_SECONDS=30
AGENT_LLM_MAX_RETRIES=1
AGENT_TEMPERATURE=0.2
AGENT_MAX_OUTPUT_TOKENS=1024

# Agent runtime (TASK-006.2-006.6)
AGENT_ENABLED=true
AGENT_MAX_INPUT_CHARS=4000
AGENT_MAX_OUTPUT_CHARS=8000
AGENT_MAX_HISTORY_MESSAGES=20
AGENT_MAX_HISTORY_CHARS=8000
AGENT_MAX_RAG_CONTEXT_CHARS=6000
AGENT_MAX_CONTEXT_CHARS=14000
AGENT_CONVERSATION_TTL_SECONDS=604800
AGENT_CONVERSATION_LOCK_TTL_MS=60000
AGENT_MAX_EXECUTION_SECONDS=40
AGENT_CONVERSATION_LOCK_SAFETY_MARGIN_SECONDS=15
AGENT_RAG_TOP_K=5
AGENT_RATE_LIMIT_PER_MINUTE=30
AGENT_MAX_TOOL_CALLS_PER_TURN=4
AGENT_ACTION_CONFIRMATION_TTL_SECONDS=300


# Generate a random secret with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ISSUER=ecommerce-agent
JWT_AUDIENCE=ecommerce-agent-api
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_LEEWAY_SECONDS=30

# ==========================================
# Orders / payments / after-sales
# ==========================================
ORDER_PAYMENT_TIMEOUT_MINUTES=30
AFTER_SALES_WINDOW_HOURS=168

# ==========================================
# RAG knowledge base
# ==========================================
RAG_ENABLED=true
RAG_QDRANT_URL=http://127.0.0.1:6333
RAG_QDRANT_API_KEY=
RAG_COLLECTION=knowledge_chunks_bge_m3_v1
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_EMBEDDING_DIMENSION=1024
RAG_EMBEDDING_DEVICE=cpu
RAG_EMBEDDING_BATCH_SIZE=8
RAG_EMBEDDING_CACHE_DIR=.cache/huggingface
RAG_TOP_K=5
RAG_MAX_CANDIDATES=20
RAG_CHUNK_TARGET_TOKENS=500
RAG_CHUNK_MAX_TOKENS=700
RAG_CHUNK_OVERLAP_TOKENS=80
RAG_MAX_FILE_SIZE_MB=20
RAG_STORAGE_DIR=storage/knowledge
