# TASK-016 production environment template.
# Copy to .env.production and fill locally. Never commit .env.production.
APP_NAME=E-Commerce Agent
APP_ENV=production
DEBUG=false
API_V1_PREFIX=/api/v1

LOG_LEVEL=INFO
LOG_FORMAT=json

# MySQL production app user. Root is only for container initialization.
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=ecommerce_agent
MYSQL_USER=ecommerce_app
MYSQL_PASSWORD=replace-with-a-strong-app-password
MYSQL_ROOT_PASSWORD=replace-with-a-strong-root-password

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

DEEPSEEK_API_KEY=replace-with-local-deepseek-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

JWT_SECRET_KEY=replace-with-at-least-32-byte-random-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=ecommerce-agent
JWT_AUDIENCE=ecommerce-agent-api
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_LEEWAY_SECONDS=30

ORDER_PAYMENT_TIMEOUT_MINUTES=30
AFTER_SALES_WINDOW_HOURS=168

RAG_ENABLED=true
RAG_QDRANT_URL=http://qdrant:6333
RAG_QDRANT_API_KEY=
RAG_COLLECTION=knowledge_chunks_bge_m3_v1
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_EMBEDDING_DIMENSION=1024
RAG_EMBEDDING_DEVICE=cpu
RAG_EMBEDDING_BATCH_SIZE=8
RAG_EMBEDDING_CACHE_DIR=/app/.cache/huggingface
RAG_TOP_K=5
RAG_MAX_CANDIDATES=20
RAG_CHUNK_TARGET_TOKENS=500
RAG_CHUNK_MAX_TOKENS=700
RAG_CHUNK_OVERLAP_TOKENS=80
RAG_MAX_FILE_SIZE_MB=20
RAG_STORAGE_DIR=/app/data/uploads

# Leave empty until real sandbox credentials and an HTTPS callback are available.
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi.alipaydev.com/gateway.do
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=
ALIPAY_FRONTEND_RETURN_URL=
